# ===== Telegram =====
TELEGRAM_BOT_TOKEN=COLE_AQUI_O_TOKEN_DO_BOTFATHER
TELEGRAM_CHAT_ID=COLE_AQUI_SEU_CHAT_ID

# ===== Monitoramento =====
# Intervalo entre rodadas (minutos). Recomendado: 15 a 30.
INTERVAL_MINUTES=20

# Janela (dias) do histórico usado para montar o preço de referência
HISTORY_DAYS=14

# Para confiar na referência, o histórico precisa ter PELO MENOS:
#  - X leituras...
MIN_HISTORY_SAMPLES=8
#  - ...espalhadas por X horas (30 leituras em 30 minutos não provam nada)
MIN_HISTORY_SPAN_HOURS=24
# Se não houver histórico suficiente o alerta NÃO dispara (a não ser que ALLOW_ALERT_WITHOUT_HISTORY=true)

# O preço atual precisa estar pelo menos X% abaixo da referência para ser "desconto real"
MIN_DISCOUNT_PCT=5

# Não repetir alerta do mesmo produto por X horas (a menos que o preço caia mais de 1%)
ALERT_COOLDOWN_HOURS=6

# Dispara alerta mesmo sem histórico suficiente (cuidado: não valida "metade do dobro")
ALLOW_ALERT_WITHOUT_HISTORY=false

# Se o monitor não achar o botão do tamanho/cor (estoque "desconhecido"):
#  true  = alerta mesmo assim, com um aviso "estoque não confirmado" (não perde promoção)
#  false = não alerta
ALERT_ON_UNKNOWN_STOCK=true

# Antes de alertar, faz uma 2ª leitura para confirmar o preço (evita alerta por leitura errada)
CONFIRM_ALERTS=true

# Avisa no Telegram (uma única vez) quando um produto falha X leituras seguidas. 0 = desligado
FAIL_NOTICE_AFTER=6

# Manda no Telegram os cupons NOVOS encontrados em cada loja (uma mensagem por loja, por rodada)
NOTIFY_COUPONS=true
# Repete um cupom já avisado depois de X horas (0 = avisa uma única vez)
COUPON_RENOTIFY_HOURS=168

# ===== Comparar o mesmo modelo em outras lojas =====
# Procura o produto (marca + modelo + número + cor) na busca das lojas de search_stores.json e avisa quando
# outra loja estiver mais barata. É busca automática: o aviso pede para você conferir modelo, cor e tamanho.
COMPARE_ENABLED=true
# só avisa se a outra loja estiver pelo menos X% abaixo da loja principal (ou abaixo do preço-alvo)
COMPARE_MIN_DIFF_PCT=5
# refaz a busca de cada produto a cada X horas
COMPARE_SEARCH_EVERY_HOURS=6
# máximo de produtos pesquisados por rodada (para não estourar o tempo)
COMPARE_MAX_SEARCHES=3
# quantas lojas/candidatos acompanhar por produto
COMPARE_MAX_CANDIDATES=4

# ===== Playwright =====
HEADLESS=true
PAGE_TIMEOUT_MS=45000
MAX_RETRIES=3

# Se preenchido (ex.: debug), salva screenshot + HTML das páginas que falharem nessa pasta.
# Ajuda a descobrir o seletor CSS certo. Deixe vazio em uso normal.
DEBUG_DIR=

# ===== Arquivos =====
DB_PATH=prices.db
PRODUCTS_PATH=products.json
LOG_FILE=monitor.log
